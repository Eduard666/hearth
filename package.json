{
  "name": "hearth",
  "version": "1.2.0",
  "description": "Local-first photo library for content creators",
  "main": "./out/main/index.js",
  "author": "Eduard666",
  "homepage": "https://github.com/Eduard666/hearth",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
